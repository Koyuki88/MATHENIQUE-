# Frontend API URL (Vite exposes VITE_* vars to the browser bundle — never put secrets here)
VITE_API_URL=http://127.0.0.1:8000

# Backend Runtime Configuration
# Set ENVIRONMENT=production when deploying to Render or another public host
ENVIRONMENT=development

# Required in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=replace-with-at-least-32-char-random-secret

# Access token TTL in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL (defaults to local SQLite in development)
DATABASE_URL=sqlite:///./mathenique.db

# Comma-separated CORS allowed origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Comma-separated TrustedHostMiddleware allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to true only when running behind a trusted reverse proxy (e.g. Render)
TRUST_PROXY_HEADERS=false
